+        const int pos = atomicAdd(&counter, 1);
+        if (pos < topk) output[pos] = idx;
+      }
+    }
+    __syncthreads();
+    return;
+  }
+
+  const int coarse_population = histogram[coarse_threshold] - histogram[coarse_threshold + 1];
+  __syncthreads();
+  if (coarse_population >= StashEntries) {
