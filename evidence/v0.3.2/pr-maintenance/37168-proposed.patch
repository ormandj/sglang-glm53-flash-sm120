+            weights,
+            context_lens,
+            block_table,
+            schedule,
+            max_context_len,
+            clean_logits=False,
+        )
+        logits = indexer._retain_full_graph_capture_owner(logits)
+        return logits[:, :1]
+
+    compiled_outer = torch.compile(
