  "known_limitations": [
    "MXFP4 MoE has no native SM120 CUTLASS path: FlashInfer #2847 and vLLM #31085 leave three runtime guards filtering SM120 (SM103/TRTLLM modules filter to supported_major_versions=[10]; SM120 is major 12). Expect the Marlin fallback, measured ~28% slower prefill on gpt-oss-120b.",
    "sglang #36596: is_layer_excluded misses fused module names and model.-prefixed names for mixed-precision checkpoints.",
    "sglang #36653: MTP MoE weights fail to load under TP>1.",
    "sglang #36599: deepseek_nextn hardcodes quant_config=None for FP4 drafts.",
    "sglang #36550: CUDA-graph abort at first decode after cold prefill > 262144 tokens.",
    "sglang #36669: thinking output degenerates into repeated '!' under multi-tool agentic prompts (native FP8, not a quantization artifact)."
  ]
