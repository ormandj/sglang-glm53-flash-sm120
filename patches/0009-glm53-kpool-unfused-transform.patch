From: CoreNode homelab <noreply@corenode.com>
Subject: [PATCH] dsa: preserve GLM-5.3 KPool tails in unfused transforms

GLM-5.3 appends three live KPool entries to the ordinary 2,048-entry DSA
selection.  The fused transform supports that 2,051-entry contract, but the
unfused decode and prefill transforms assert an exact width of 2,048.

Keep the tuned decode kernel unchanged for the normal width.  Route only the
exact 2,051-entry GLM width through a tiled stride-aware transform and allow
the already-dynamic prefill kernel to consume that width.  Continue to fail
closed for every other width.

---
diff --git a/python/sglang/kernels/ops/attention/dsa/transform_index.py b/python/sglang/kernels/ops/attention/dsa/transform_index.py
index 8fbfa190f5..48d813f0b4 100644
--- a/python/sglang/kernels/ops/attention/dsa/transform_index.py
+++ b/python/sglang/kernels/ops/attention/dsa/transform_index.py
@@ -116,6 +116,43 @@ def transform_index_page_table_decode_kernel(
     tl.store(result_ptr + offset, -1, mask=~mask)
 
 
+@triton.jit
+def transform_index_page_table_decode_dynamic_kernel(
+    page_table_ptr: torch.Tensor,
+    topk_indices_ptr: torch.Tensor,
+    result_ptr: torch.Tensor,
+    page_table_stride_0: tl.constexpr,
+    topk_indices_stride_0: tl.constexpr,
+    topk_indices_stride_1: tl.constexpr,
+    result_stride_0: tl.constexpr,
+    result_stride_1: tl.constexpr,
+    TOPK: tl.constexpr,
+    BLOCK_TOPK: tl.constexpr,
+):
+    """Transform non-2048 DSA tables without dropping model-specific tails."""
+    req_id = tl.program_id(0)
+    offsets = tl.program_id(1) * BLOCK_TOPK + tl.arange(0, BLOCK_TOPK)
+    mask = offsets < TOPK
+    loaded_topk_indices = tl.load(
+        topk_indices_ptr
+        + req_id * topk_indices_stride_0
+        + offsets * topk_indices_stride_1,
+        mask=mask,
+        other=-1,
+    )
+    valid = mask & (loaded_topk_indices >= 0)
+    loaded_kv_indices = tl.load(
+        page_table_ptr + req_id * page_table_stride_0 + loaded_topk_indices,
+        mask=valid,
+        other=-1,
+    )
+    tl.store(
+        result_ptr + req_id * result_stride_0 + offsets * result_stride_1,
+        loaded_kv_indices,
+        mask=mask,
+    )
+
+
 @triton.jit
 def transform_index_page_table_prefill_kernel(
     page_table_ptr: torch.Tensor,
@@ -191,19 +228,39 @@ def transform_index_page_table_decode_fast(
     """
     assert page_size == 1
     assert page_table.shape[0] == topk_indices.shape[0]
-    assert topk_indices.shape[1] == 2048
+    assert topk_indices.shape[1] in (2048, 2051)
     qo_len = topk_indices.shape[0]
     if result is None:
         result = torch.empty_like(topk_indices, dtype=torch.int32)
-    # Launch triton kernel
-    grid = (qo_len,)
-    transform_index_page_table_decode_kernel[grid](
-        page_table,
-        topk_indices,
-        result,
-        page_size,
-        page_table_row_stride=page_table.stride(0),
-    )
+    assert result.shape == topk_indices.shape
+
+    # Preserve the tuned one-program path for the normal 2,048-entry table.
+    # GLM-5.3 KPool appends three live tail entries, so route its 2,051-entry
+    # table through the bounded dynamic kernel instead of truncating the tail.
+    if topk_indices.shape[1] == 2048:
+        transform_index_page_table_decode_kernel[(qo_len,)](
+            page_table,
+            topk_indices,
+            result,
+            page_size,
+            page_table_row_stride=page_table.stride(0),
+        )
+    else:
+        block_topk = 256
+        grid = (qo_len, triton.cdiv(topk_indices.shape[1], block_topk))
+        transform_index_page_table_decode_dynamic_kernel[grid](
+            page_table,
+            topk_indices,
+            result,
+            page_table.stride(0),
+            topk_indices.stride(0),
+            topk_indices.stride(1),
+            result.stride(0),
+            result.stride(1),
+            TOPK=topk_indices.shape[1],
+            BLOCK_TOPK=block_topk,
+            num_warps=4,
+        )
     return result
 
 
@@ -217,7 +274,7 @@ def transform_index_page_table_prefill_fast(
     cu_seqlens_q: Optional[torch.Tensor] = None,
 ) -> torch.Tensor:
     assert page_size == 1
-    assert topk_indices.shape[1] == 2048
+    assert topk_indices.shape[1] in (2048, 2051)
     real_num_tokens = sum(extend_lens_cpu)
     result = _allocate_prefill_result(topk_indices, real_num_tokens, output_num_tokens)
     if real_num_tokens == 0:
