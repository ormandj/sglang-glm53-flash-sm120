+                .reg .b32 b, r;
+                .reg .pred z;
+                shr.u32 b, $1, {shift};
+                and.b32 b, b, 0xFF;
+                add.u32 r, b, 840;
+                shl.b32 r, r, 20;
+                setp.eq.u32 z, b, 0;
+                selp.b32 r, 0, r, z;
+                mov.b32 $0, r;
+            }}
