+        const float nm = fmaxf(warp_m[ih], rm);
+        alpha[ih] = exp2f(warp_m[ih] - nm);
+        smax[ih] = exp2f(rm - nm);
+        warp_m[ih] = nm;
+
+        float rs = 0.f;
+#pragma unroll
+        for (int m = 0; m < CT::MTILES; m++) {
+          s[m][ih] = exp2f(s[m][ih] - nm);
