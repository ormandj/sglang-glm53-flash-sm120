+    block_tables = torch.empty((0, 1, topk), dtype=torch.int32, device=device)
+    workspace = torch.empty(8 << 20, dtype=torch.uint8, device=device)
+    kwargs = dict(
+        query=query,
+        kv_cache=kv_hnd,
+        workspace_buffer=workspace,
+        qk_nope_head_dim=512,
+        kv_lora_rank=512,
