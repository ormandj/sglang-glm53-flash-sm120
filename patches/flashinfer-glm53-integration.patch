+        s[m][1] = v0 ? qk[m][1] * sm_scale_log2e : -1e30f;
+        s[m][2] = v1 ? qk[m][2] * sm_scale_log2e : -1e30f;
+        s[m][3] = v1 ? qk[m][3] * sm_scale_log2e : -1e30f;
