+      float alpha[2];
+      float smax[2];
+#pragma unroll
+      for (int ih = 0; ih < 2; ih++) {
+        float rm = -1e30f;
+#pragma unroll
+        for (int m = 0; m < CT::MTILES; m++) rm = fmaxf(rm, fmaxf(s[m][ih], s[m][2 + ih]));
+        rm = warp8_reduce_max(rm);
