+// FP8 [32×16] → the [16×32] A operand: lane l addresses row l, 16B aligned
+__device__ __forceinline__ void ldmatrix_x2_trans_b8(uint32_t& d0, uint32_t& d1, uint32_t& d2,
+                                                     uint32_t& d3, const void* smem_ptr) {
