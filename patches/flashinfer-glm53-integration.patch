+                xv[mt][1] = r.d1;
+                xv[mt][2] = r.d2;
+                xv[mt][3] = r.d3;
+              }
+
+#pragma unroll
+          for (int mt = 0; mt < CT::XV_MTILES; mt++) {
+            float* o = acc_o[vc][mt];
+            o[0] = fmaf(xv[mt][0], wsc[0], o[0] * alpha[0]);
+            o[1] = fmaf(xv[mt][1], wsc[1], o[1] * alpha[1]);
+            o[2] = fmaf(xv[mt][2], wsc[0], o[2] * alpha[0]);
