+    uint8_t sfb[KV::NUM_SCALES];
+    float q_sc[2][KV::NUM_SCALES];
+    if constexpr (SOFT_SCALE) {
+#pragma unroll
+      for (int g = 0; g < KV::NUM_SCALES; g++) {
+        q_sc[0][g] = __shfl_sync(0xffffffff, q.scale[g], 8 * tid);
+        q_sc[1][g] = __shfl_sync(0xffffffff, q.scale[g], 8 * tid + 4);
+      }
+    } else {
