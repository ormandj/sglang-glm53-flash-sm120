+    weights = _capture_weight_entries(capturing=True)
+    assert [parked] == moe_dispatch._GRAPH_REFERENCED_WORKSPACES
+    devices = {torch.device("cuda", 0), torch.device("cuda", 1)}
+    synchronized = []
