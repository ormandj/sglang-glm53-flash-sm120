+    def _signal_serving_started(self) -> None:
+        """Arm the schedulers' late Triton-load diagnostics (triton_load_watch).
+
+        The HTTP server sends this after its request-driven warmups; the
+        Engine runs none, so it sends it right after init. Constructed
+        outside a running loop (the usual case) the signal is sent and awaited
+        here. Constructed inside a running loop, an async server building an
+        Engine, that loop is this thread's, so blocking on it would deadlock:
+        the signal is scheduled on it as ``self.serving_started_task``, its
+        outcome is logged when it completes, and async callers may await the
+        task. A failure is logged at error level either way and the
+        schedulers stay unarmed (diagnostics off, never false positives).
+        """
+        self.serving_started_task = None
+        if self.tokenizer_manager is None:
+            # Non-zero node ranks: their schedulers receive rank 0's broadcast.
+            return
+        async def signal_engine_ready():
+            # Engine workers run no HTTP request warmups. The parent therefore
+            # publishes readiness for the configured tokenizer worker count.
+            args = getattr(self, "server_args", None)
+            workers = max(1, getattr(args, "tokenizer_worker_num", 1))
+            for _ in range(workers):
+                replies = await self.tokenizer_manager.mark_serving_started()
+            return replies
+
+        coro = signal_engine_ready()
+        if self.loop.is_running():
+            task = self.loop.create_task(coro)
+            task.add_done_callback(self._on_serving_started_done)
+            self.serving_started_task = task
+            return
+        try:
+            self.loop.run_until_complete(coro)
+        except Exception:
+            logger.error(
+                "serving-started signal failed; the schedulers' late Triton-load "
+                "diagnostics stay unarmed.",
+                exc_info=True,
+            )
+
+    @staticmethod
+    def _on_serving_started_done(task: asyncio.Task) -> None:
+        if task.cancelled():
+            logger.error(
+                "serving-started signal cancelled; the schedulers' late "
+                "Triton-load diagnostics stay unarmed."
+            )
+            return
+        error = task.exception()
+        if error is not None:
+            logger.error(
+                "serving-started signal failed: %r; the schedulers' late "
+                "Triton-load diagnostics stay unarmed.",
+                error,
+            )
+
