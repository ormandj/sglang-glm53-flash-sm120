+import unittest
+from unittest import mock
+
+import torch
+
+from sglang.srt.layers.attention.dsa import dsa_indexer_kpool as kpool_module
+from sglang.srt.layers.attention.dsa.dsa_indexer_kpool import IndexerKPool
+from sglang.srt.model_executor.runner_utils.capture_owner import (
+    collect_full_cuda_graph_owners,
+    retain_full_cuda_graph_owner,
+)
+from sglang.test.ci.ci_register import register_cpu_ci
+
+register_cpu_ci(est_time=2, suite="base-a-test-cpu")
+
+
+class Projection(torch.nn.Module):
+    def __init__(self):
+        super().__init__()
+        self.linear = torch.nn.Linear(128, 32, bias=False)
+
+    def forward(self, value):
+        return self.linear(value), None
+
+
+class TestDSALogitsGateOwner(unittest.TestCase):
+    def test_paged_path_retains_real_logits_before_topk(self):
+        indexer = object.__new__(IndexerKPool)
+        torch.nn.Module.__init__(indexer)
+        indexer.paged_mqa_logits_backend = mock.Mock()
+        indexer.paged_mqa_logits_backend.is_aiter.return_value = False
+        q_fp8 = torch.empty(24, 32, 128)
+        weights = torch.empty(24, 32, 1)
+        seqlens = torch.full((24,), 2240, dtype=torch.int32)
+        block_tables = torch.zeros(24, 35, dtype=torch.int32)
+        kv_cache = torch.empty(1, 64 * 132)
+        logits = torch.empty(24, 2240)
+        topk = torch.empty(24, 2051, dtype=torch.int32)
+        events = []
+
+        forward_batch = mock.Mock()
+        forward_batch.forward_mode.is_target_verify.return_value = True
+        metadata = mock.Mock()
+        metadata.get_page_table_64.return_value = block_tables
+        metadata.get_seqlens_expanded.return_value = seqlens
+        pool = mock.Mock(page_size=64, index_page_size=64)
+        fake_deep_gemm = mock.Mock()
+        fake_deep_gemm.fp8_paged_mqa_logits.return_value = logits
+
+        def retain(candidate, layer_id):
+            events.append(("retain", candidate, layer_id))
+            return candidate
+
+        def consume(candidate, *args, **kwargs):
+            events.append(("topk", candidate))
+            return topk
+
+        with (
+            mock.patch.object(kpool_module, "get_token_to_kv_pool", return_value=pool),
+            mock.patch.object(kpool_module, "deep_gemm", fake_deep_gemm, create=True),
+            mock.patch.object(kpool_module, "register_graph_buffer"),
+            mock.patch.object(
+                IndexerKPool, "_get_index_k_read_buffer", return_value=kv_cache
+            ),
+            mock.patch.object(
+                IndexerKPool,
+                "_get_kpool_decode_metadata",
+                return_value=(seqlens, seqlens.unsqueeze(1), block_tables, None),
+            ),
+            mock.patch.object(
+                IndexerKPool,
+                "_should_use_tilelang_paged_mqa_logits",
+                return_value=False,
+            ),
+            mock.patch.object(
+                IndexerKPool,
+                "_kpool_fused_topk_mapping",
+                return_value=(block_tables, None, None),
+            ),
+            mock.patch.object(
+                IndexerKPool,
+                "_retain_paged_logits_capture_owner",
+                side_effect=retain,
+            ),
+            mock.patch.object(
+                IndexerKPool, "_topk_from_kpool_logits", side_effect=consume
+            ),
+        ):
+            result = indexer._get_topk_paged(forward_batch, 7, q_fp8, weights, metadata)
+
+        self.assertIs(result, topk)
+        self.assertEqual([event[0] for event in events], ["retain", "topk"])
+        self.assertIs(events[0][1], logits)
+        self.assertEqual(events[0][2], 7)
+        self.assertIs(events[1][1], logits)
+
+    def test_compiled_output_is_owned_by_active_full_graph_capture(self):
+        indexer = object.__new__(IndexerKPool)
+        torch.nn.Module.__init__(indexer)
+        indexer.paged_mqa_logits_backend = mock.Mock()
+        indexer.paged_mqa_logits_backend.is_aiter.return_value = False
+        output = torch.empty(24, 32, 1)
+
+        with (
+            mock.patch.object(
+                IndexerKPool, "_get_logits_head_gate_compiled", return_value=output
+            ) as compiled_gate,
+            collect_full_cuda_graph_owners() as owners,
+        ):
+            result = indexer._get_logits_head_gate(
+                mock.sentinel.hidden, mock.sentinel.scale
+            )
+
+        self.assertIs(result, output)
+        self.assertEqual(len(owners), 1)
+        self.assertIs(owners[0], output)
+        compiled_gate.assert_called_once_with(mock.sentinel.hidden, mock.sentinel.scale)
+
+    def test_eager_call_does_not_create_process_global_owners(self):
+        indexer = object.__new__(IndexerKPool)
+        torch.nn.Module.__init__(indexer)
+        indexer.paged_mqa_logits_backend = mock.Mock()
+        indexer.paged_mqa_logits_backend.is_aiter.return_value = False
+        output = torch.empty(64, 32, 1)
+
+        with mock.patch.object(
+            IndexerKPool, "_get_logits_head_gate_compiled", return_value=output
+        ) as compiled_gate:
+            with collect_full_cuda_graph_owners() as owners:
+                captured_result = indexer._get_logits_head_gate(
+                    mock.sentinel.hidden, mock.sentinel.scale
+                )
+
+            eager_result = indexer._get_logits_head_gate(
+                mock.sentinel.hidden, mock.sentinel.scale
+            )
+
+        self.assertIs(captured_result, output)
+        self.assertIs(eager_result, output)
+        self.assertEqual(len(owners), 1)
+        self.assertIs(owners[0], output)
+        self.assertFalse(retain_full_cuda_graph_owner(object()))
+        self.assertEqual(compiled_gate.call_count, 2)
+
+    def test_outer_torch_compile_preserves_capture_owner(self):
+        torch.manual_seed(48)
+        indexer = IndexerKPool.__new__(IndexerKPool)
+        torch.nn.Module.__init__(indexer)
+        indexer.weights_proj = Projection()
+        indexer.n_heads = 32
+        indexer.softmax_scale = 128**-0.5
+        hidden = torch.randn(64, 128)
+        q_scale = torch.rand(64, 32, 1)
+
+        def outer(value, scale):
+            return indexer._get_logits_head_gate(value, scale)
+
+        compiled_outer = torch.compile(outer, backend="eager", dynamic=False)
+        compiled_outer(hidden, q_scale)
+
+        with collect_full_cuda_graph_owners() as owners:
+            output = compiled_outer(hidden, q_scale)
+
+        self.assertEqual(len(owners), 1)
+        self.assertIs(owners[0], output)
+
+    def test_outer_torch_compile_preserves_paged_logits_owner(self):
+        indexer = object.__new__(IndexerKPool)
+        torch.nn.Module.__init__(indexer)
+        indexer.paged_mqa_logits_backend = mock.Mock()
+        indexer.paged_mqa_logits_backend.is_aiter.return_value = False
+        values = torch.randn(16, 32)
+
+        def outer(value):
+            logits = value.float().square()
+            logits = indexer._retain_paged_logits_capture_owner(logits, 7)
+            return logits.to(torch.int32)
+
+        compiled_outer = torch.compile(outer, backend="eager", dynamic=False)
+        compiled_outer(values)
+
+        with collect_full_cuda_graph_owners() as owners:
+            output = compiled_outer(values)
+
+        self.assertEqual(output.dtype, torch.int32)
+        self.assertEqual(len(owners), 1)
+        self.assertEqual(owners[0].dtype, torch.float32)
+        torch.testing.assert_close(owners[0], values.float().square())
+
+    def test_capture_without_full_graph_owner_scope_is_unchanged(self):
+        indexer = object.__new__(IndexerKPool)
+        torch.nn.Module.__init__(indexer)
+        indexer.paged_mqa_logits_backend = mock.Mock()
+        indexer.paged_mqa_logits_backend.is_aiter.return_value = False
+        output = mock.Mock(is_cuda=True)
+
+        with (
+            mock.patch.object(
+                IndexerKPool, "_get_logits_head_gate_compiled", return_value=output
+            ),
+            mock.patch.object(
+                torch.cuda, "is_current_stream_capturing", return_value=True
+            ),
+        ):
+            result = indexer._get_logits_head_gate(
+                mock.sentinel.hidden, mock.sentinel.scale
+            )
+
+        self.assertIs(result, output)
+
+    def test_cuda_capture_with_owner_scope_retains_without_raising(self):
+        indexer = object.__new__(IndexerKPool)
+        torch.nn.Module.__init__(indexer)
+        indexer.paged_mqa_logits_backend = mock.Mock()
+        indexer.paged_mqa_logits_backend.is_aiter.return_value = False
+        output = mock.Mock(is_cuda=True)
+
+        with (
+            mock.patch.object(
+                IndexerKPool, "_get_logits_head_gate_compiled", return_value=output
+            ),
+            mock.patch.object(
+                torch.cuda, "is_current_stream_capturing", return_value=True
+            ),
+            collect_full_cuda_graph_owners() as owners,
+        ):
+            result = indexer._get_logits_head_gate(
+                mock.sentinel.hidden, mock.sentinel.scale
+            )
+
+        self.assertIs(result, output)
+        self.assertEqual(len(owners), 1)
+        self.assertIs(owners[0], output)
+
+
+if __name__ == "__main__":
+    unittest.main()
