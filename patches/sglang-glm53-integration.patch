+class FakeTokenizerManager:
+    """Records every request handed to generate_request and its concurrency."""
+
+    def __init__(
+        self,
+        image_token=None,
+        tokenizer=object(),
+        max_req_input_len=INPUT_LIMIT,
+    ):
+        self.max_req_input_len = max_req_input_len
