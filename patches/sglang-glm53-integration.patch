+from sglang.srt.layers.linear import (
+    ColumnParallelLinear,
+    QKVParallelLinear,
+    ReplicatedLinear,
+)
+from sglang.srt.layers.quantization.modelopt_quant import (
+    ModelOptMixedPrecisionConfig,
+)
+from sglang.srt.layers.quantization.unquant import UnquantizedLinearMethod
+from sglang.srt.layers.quantization.utils import are_linear_prefixes_unquantized
+from sglang.test.ci.ci_register import register_cpu_ci
+
+register_cpu_ci(est_time=2, suite="base-a-test-cpu")
+
+
+def test_modelopt_mixed_fusion_gate_uses_per_layer_precision():
+    linear_specs = (
+        ("model.layers.0.self_attn.qkv_proj", QKVParallelLinear),
+        ("model.layers.0.self_attn.f_a_proj", ReplicatedLinear),
+        ("model.layers.0.self_attn.f_b_proj", ColumnParallelLinear),
+        ("model.layers.0.self_attn.b_proj", ColumnParallelLinear),
+        ("model.layers.0.self_attn.g_a_proj", ReplicatedLinear),
+        ("model.layers.0.self_attn.g_b_proj", ColumnParallelLinear),
+    )
+    quant_config = ModelOptMixedPrecisionConfig.from_config(
+        {
+            "quant_algo": "MIXED_PRECISION",
+            "quantized_layers": {
+                "model.layers.0.mlp.experts.0.w1": {
+                    "quant_algo": "W4A16_NVFP4",
+                    "group_size": 32,
+                }
+            },
+            "packed_modules_mapping": {},
+        }
+    )
+
+    # Quantized experts do not prevent fusion of BF16 attention projections.
+    assert are_linear_prefixes_unquantized(quant_config, linear_specs)
+
+    # A genuinely quantized source projection must keep the unfused path.
+    quant_config.quantized_layers[linear_specs[0][0]] = {"quant_algo": "FP8_PB_WO"}
+    assert not are_linear_prefixes_unquantized(quant_config, linear_specs)
+
+
+def test_fusion_gate_preserves_concrete_linear_class_for_quant_dispatch():
+    class ClassTargetQuantConfig:
+        def get_quant_method(self, layer, prefix):
+            if layer.__class__.__name__ == "QKVParallelLinear":
+                return object()
+            return UnquantizedLinearMethod()
+
+    assert not are_linear_prefixes_unquantized(
+        ClassTargetQuantConfig(),
+        [("model.layers.0.self_attn.qkv_proj", QKVParallelLinear)],
+    )
