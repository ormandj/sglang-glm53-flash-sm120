+        if (coarse_key(value) != coarse_threshold) continue;
+        const uint32_t key = exact_key(value);
+        if ((key & prefix_mask) != prefix) continue;
+        atomicAdd(&histogram[(key >> shift) & 0xFFu], 1);
+      }
+      __syncthreads();
