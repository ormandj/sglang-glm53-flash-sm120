+"""The b12x W4A16 runner reads its expert placement from the runner config."""
+
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+from sglang.srt.layers.moe.moe_runner.base import MoeRunnerConfig
+from sglang.srt.layers.moe.moe_runner.flashinfer_cutlass import (
+    FlashInferCutlassMoeQuantInfo,
+    _run_flashinfer_b12x_w4a16,
+)
+from sglang.test.ci.ci_register import register_cpu_ci
+
+register_cpu_ci(est_time=5, suite="base-a-test-cpu")
+
+
+def _run(*, ep_size):
+    quant_info = FlashInferCutlassMoeQuantInfo(
+        quant_type="w4a16_e4m3_k32",
+        w13_weight=torch.empty(0),
+        w2_weight=torch.empty(0),
+        quant_scales=[torch.empty(0)] * 4,
+    )
+    runner_config = MoeRunnerConfig(
+        num_experts=8,
+        num_local_experts=4,
+        layer=SimpleNamespace(moe_ep_size=ep_size),
+    )
+    _run_flashinfer_b12x_w4a16(
+        dispatch_output=None,
+        quant_info=quant_info,
+        runner_config=runner_config,
+        output=None,
+        enable_alltoall=False,
+    )
+
+
+def test_expert_parallel_layer_is_rejected():
+    with pytest.raises(NotImplementedError, match="EP size 1"):
+        _run(ep_size=2)
+
+
+def test_ep1_layer_passes_the_placement_check():
+    # The next guard requires every expert to be local; reaching it means the
+    # placement was read from the layer rather than the quant payload.
+    with pytest.raises(NotImplementedError, match="every expert to be local"):
+        _run(ep_size=1)
