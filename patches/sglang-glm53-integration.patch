+        )
+        indexer = _fake_indexer()
+        out_start = 5
+        out = torch.full(
+            (out_start + n_rows + 2, TOPK_WIDTH), -1, dtype=torch.int32, device="cuda"
+        )
+        indexer._chunked_kpool_logits_topk(
+            q_fp8=layout["q_fp8"],
+            kv_fp8=layout["kv_fp8"],
+            weights=layout["weights"],
+            ks=layout["ks"],
+            ke=layout["ke"],
+            topk_row_starts=None,
+            pool_lens=layout["pool_lens"],
+            seq_lens=layout["seq_lens"],
+            page_table=page_table,
+            topk_offsets=None,
+            page_table_row_index=None,
+            out=out,
+            out_start=out_start,
+            max_rows=19,
+        )
+        self._verify_selection(
+            out[out_start : out_start + n_rows],
+            layout,
+            gt_logits,
+            lambda r, t: inverse[t.long()],
+            "legacy-chunked",
+        )
+        self.assertTrue(torch.all(out[:out_start] == -1))
+        self.assertTrue(torch.all(out[out_start + n_rows :] == -1))
+
+    def test_zero_rows_is_a_noop(self):
