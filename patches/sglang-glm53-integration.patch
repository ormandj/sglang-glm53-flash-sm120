+import sys
+from types import SimpleNamespace
+from unittest import mock
+
+import pytest
+import torch
+
+from sglang.srt.models.deepseek_common.attention_forward_methods import forward_mha
+from sglang.test.ci.ci_register import register_cpu_ci
+
+register_cpu_ci(
+    est_time=10,
