+    scale_out = torch.empty((1,), dtype=torch.float32, device=device)
+    pool = type("_PrecompilePool", (), {"index_page_size": page_size})()
+    gather_index_k_scale_prefix_into(pool, buf, page_indices, 1, k_out, scale_out)
+    return True
+
+
 def kpool_max_closed_pools(num_draft_tokens: int, kpool: int) -> int:
     return (num_draft_tokens + kpool - 1) // kpool
 
