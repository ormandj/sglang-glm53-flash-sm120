+def dsa_pool(*, live_layers=(True, True), compress=True, kpool=4):
+    pool = object.__new__(DSATokenToKVPool)
+    pool.page_size = 64
+    pool.index_kpool = kpool
+    pool.kpool_use_compress = compress
