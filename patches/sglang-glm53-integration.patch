+        x = (acc / denom).to(tl.bfloat16).to(tl.float32)
+        x = _hadamard128(x).to(tl.bfloat16).to(tl.float32)
+
+        fp8_min = -448.0
+        fp8_max = 448.0
+        fp8_max_inv = 1.0 / fp8_max
+        absmax = tl.max(tl.abs(x), axis=0)
+        absmax = tl.maximum(absmax, 1e-4)
