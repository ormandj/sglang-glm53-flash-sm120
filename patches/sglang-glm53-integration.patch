+        return_value="logical-overlap:kpool-logits-layer-0",
+    )
+    def test_oob_includes_graph_buffer_overlap(self, describe_overlap, _):
+        allocator = self._allocator()
+        allocator.free_pages[0] = 4096
+
+        with self.assertRaisesRegex(
+            AssertionError,
+            "dsa_graph_buffers=logical-overlap:kpool-logits-layer-0",
+        ):
+            allocator._debug_check_free_pages("before alloc_extend")
+
+        describe_overlap.assert_called_once_with(allocator.free_pages)
+
+
+if __name__ == "__main__":
+    unittest.main()
