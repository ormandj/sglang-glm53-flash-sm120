+"""Unit tests for the Engine's serving-started signal, no subprocesses.
+
+The Engine runs no request-driven warmups, so it signals right after init:
+synchronously when built outside a running loop, and as an observed task on
+the loop when built inside one (an async server constructing an Engine).
+"""
+
+import asyncio
+import unittest
+
+from sglang.test.ci.ci_register import register_cpu_ci
+from sglang.test.test_utils import maybe_stub_sgl_kernel
+
+maybe_stub_sgl_kernel()
+
+from sglang.srt.entrypoints.engine import Engine
+
+register_cpu_ci(est_time=8, suite="base-a-test-cpu")
+
+MOD = "sglang.srt.entrypoints.engine"
+
+
+class FakeTokenizerManager:
+    def __init__(self, error=None):
+        self.calls = 0
+        self.error = error
+
+    async def mark_serving_started(self):
+        self.calls += 1
+        await asyncio.sleep(0)
+        if self.error is not None:
+            raise self.error
+        return ["rank-0"]
+
+
+def _engine(tokenizer_manager, loop):
+    engine = Engine.__new__(Engine)
+    engine.tokenizer_manager = tokenizer_manager
+    engine.loop = loop
+    return engine
+
+
+class TestEngineSignalOutsideALoop(unittest.TestCase):
+    def setUp(self):
+        self.loop = asyncio.new_event_loop()
+        self.addCleanup(self.loop.close)
+
+    def test_sends_and_waits_synchronously(self):
+        tm = FakeTokenizerManager()
+        engine = _engine(tm, self.loop)
+        engine._signal_serving_started()
+        self.assertEqual(tm.calls, 1)
+        self.assertIsNone(engine.serving_started_task)
+
+    def test_signals_every_configured_tokenizer_worker(self):
+        from types import SimpleNamespace
+
+        tm = FakeTokenizerManager()
+        engine = _engine(tm, self.loop)
+        engine.server_args = SimpleNamespace(tokenizer_worker_num=3)
+        engine._signal_serving_started()
+        self.assertEqual(tm.calls, 3)
+
+    def test_a_failure_is_logged_at_error_and_does_not_raise(self):
+        engine = _engine(FakeTokenizerManager(RuntimeError("down")), self.loop)
+        with self.assertLogs(MOD, level="ERROR") as cm:
+            engine._signal_serving_started()
+        self.assertTrue(any("stay unarmed" in line for line in cm.output))
+
+    def test_no_tokenizer_manager_means_no_signal(self):
+        # Non-zero node ranks: the scheduler receives rank 0's broadcast.
+        engine = _engine(None, self.loop)
+        engine._signal_serving_started()
+        self.assertIsNone(engine.serving_started_task)
+
+
+class TestEngineSignalInsideARunningLoop(unittest.TestCase):
+    def test_schedules_on_the_running_loop_and_the_result_is_awaitable(self):
+        tm = FakeTokenizerManager()
+
+        async def build_engine_inside_async_server():
+            engine = _engine(tm, asyncio.get_running_loop())
+            engine._signal_serving_started()
+            # The constructor returned without blocking its own loop...
+            self.assertIsNotNone(engine.serving_started_task)
+            self.assertEqual(tm.calls, 0)
+            # ...and the signal completes once the caller yields.
+            replies = await engine.serving_started_task
+            return replies
+
+        replies = asyncio.run(build_engine_inside_async_server())
+        self.assertEqual(replies, ["rank-0"])
+        self.assertEqual(tm.calls, 1)
+
+    def test_a_failure_on_the_loop_is_observed_and_logged(self):
+        tm = FakeTokenizerManager(RuntimeError("scheduler gone"))
+
+        async def scenario():
+            engine = _engine(tm, asyncio.get_running_loop())
+            with self.assertLogs(MOD, level="ERROR") as cm:
+                engine._signal_serving_started()
+                with self.assertRaisesRegex(RuntimeError, "scheduler gone"):
+                    await engine.serving_started_task
+                # Done callbacks run on the next loop iteration.
+                await asyncio.sleep(0)
+            return cm.output
+
+        output = asyncio.run(scenario())
+        self.assertTrue(any("scheduler gone" in line for line in output))
+        self.assertTrue(any("stay unarmed" in line for line in output))
+
+    def test_a_cancelled_signal_is_logged(self):
+        tm = FakeTokenizerManager()
+
+        async def scenario():
+            engine = _engine(tm, asyncio.get_running_loop())
+            with self.assertLogs(MOD, level="ERROR") as cm:
+                engine._signal_serving_started()
+                engine.serving_started_task.cancel()
+                with self.assertRaises(asyncio.CancelledError):
+                    await engine.serving_started_task
+                await asyncio.sleep(0)
+            return cm.output
+
+        output = asyncio.run(scenario())
+        self.assertTrue(any("cancelled" in line for line in output))
+
+
+if __name__ == "__main__":
+    unittest.main()
