+            q_fp8=layout["q_fp8"],
+            kv_fp8=layout["kv_fp8"],
+            weights=layout["weights"],
+            ks=layout["ks"],
+            ke=layout["ke"],
+            topk_row_starts=layout["ks"],
+            pool_lens=layout["pool_lens"],
+            seq_lens=layout["seq_lens"],
+            page_table=page_table,
+            topk_offsets=topk_offsets,
+            page_table_row_index=row_index,
+            out=out,
+            out_start=0,
+            max_rows=max_rows,
+        )
+        return out
+
+    def _verify_selection(self, sel, layout, gt_logits, inverse_fn, label):
+        n_rows = layout["n_rows"]
+        for r in range(n_rows):
+            ks = int(layout["ks"][r])
+            ke = int(layout["ke"][r])
+            pool_len = ke - ks
+            tail_count = int(layout["seq_lens"][r]) % POOL_SIZE
+            row = sel[r]
+            valid = row[row >= 0]
+            self.assertEqual(
+                valid.numel(),
+                GROUP_TOPK * POOL_SIZE + tail_count,
+                f"{label}: row {r} selected count",
+            )
+            raw = inverse_fn(r, valid)
+            tails = raw[raw >= pool_len * POOL_SIZE]
+            expected_tails = torch.arange(
+                pool_len * POOL_SIZE,
+                pool_len * POOL_SIZE + tail_count,
+                dtype=raw.dtype,
+                device=raw.device,
+            )
+            self.assertTrue(
+                torch.equal(torch.sort(tails).values, expected_tails),
+                f"{label}: row {r} tail tokens",
+            )
+            hist = raw[raw < pool_len * POOL_SIZE]
+            self.assertTrue(bool((hist >= 0).all()), f"{label}: row {r} range")
+            groups, counts = torch.unique(hist // POOL_SIZE, return_counts=True)
+            self.assertEqual(groups.numel(), GROUP_TOPK, f"{label}: row {r} groups")
+            self.assertTrue(
+                bool((counts == POOL_SIZE).all()),
+                f"{label}: row {r} partial group expansion",
+            )
+            scores = gt_logits[r, ks:ke]
+            sel_scores = torch.sort(scores[groups.long()]).values
+            top_scores = torch.sort(torch.topk(scores, GROUP_TOPK).values).values
+            torch.testing.assert_close(
+                sel_scores,
+                top_scores,
+                rtol=1e-5,
+                atol=1e-3,
+                msg=f"{label}: row {r} selection is not a true top-k",
+            )
+
+    def _run_case(self, page_table_kind, permute=False, out_rows_extra=0, seed=7):
+        layout = _build_layout(seed, self.REQ_SPECS, permute=permute)
+        n_rows = layout["n_rows"]
+        out_rows = n_rows + out_rows_extra
+        gt_logits = _ground_truth_logits(layout)
+        page_table = None
+        topk_offsets = None
+        row_index = None
+        if page_table_kind == "ragged":
+            base = torch.cumsum(layout["seq_lens"].to(torch.int64), dim=0)
+            topk_offsets = torch.cat(
+                [
+                    torch.zeros(1, dtype=torch.int64, device="cuda"),
+                    base[:-1],
+                ]
+            ).to(torch.int32)
+
+            def inverse_fn(r, tokens):
+                return tokens - topk_offsets[r]
+
+        elif page_table_kind == "paged":
+            max_seq = max(layout["seq_len_rows"]) + POOL_SIZE
+            flat = torch.randperm(
+                layout["n_reqs"] * max_seq, dtype=torch.int32, device="cuda"
+            )
+            page_table = flat.reshape(layout["n_reqs"], max_seq)
+            row_index = layout["req_of_row"]
+            inverse = torch.empty_like(flat)
+            inverse[flat.long()] = torch.arange(
+                flat.numel(), dtype=torch.int32, device="cuda"
+            )
+
+            def inverse_fn(r, tokens):
+                pos = inverse[tokens.long()]
+                req = int(layout["req_of_row"][r])
+                self.assertTrue(
+                    bool((pos // max_seq == req).all()),
+                    f"row {r} maps into another request's page table row",
+                )
+                return pos % max_seq
+
+        else:
+
+            def inverse_fn(r, tokens):
+                return tokens
+
+        ref = self._single_shot(layout, page_table, topk_offsets, row_index, out_rows)
+        self._verify_selection(ref, layout, gt_logits, inverse_fn, "single-shot")
+        for max_rows in (37, n_rows, 1 + n_rows // 2):
+            got = self._chunked(
+                layout, page_table, topk_offsets, row_index, out_rows, max_rows
+            )
+            self._verify_selection(
+                got, layout, gt_logits, inverse_fn, f"chunked[{max_rows}]"
+            )
+            if out_rows_extra:
+                self.assertTrue(torch.all(got[n_rows:] == -1))
+        if out_rows_extra:
+            self.assertTrue(torch.all(ref[n_rows:] == -1))
+
+    def test_raw_indices(self):
