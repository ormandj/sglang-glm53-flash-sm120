@@ -0,0 +1,111 @@
+"""The eager MLA bridge must use live replay metadata and latent inputs."""
+
+from types import SimpleNamespace
+from unittest.mock import patch
+
+import torch
+
+from sglang.srt.layers.communicator_mhc import MHCLayerCommunicator
+from sglang.srt.models.glm5_next import _bcg_eager_mla_attention_block
+from sglang.test.ci.ci_register import register_cpu_ci
+
+register_cpu_ci(est_time=3, suite="base-a-test-cpu")
+
+
+def test_mla_bridge_refreshes_live_batch_and_preparation():
+    captured = SimpleNamespace(value=-1)
+    context = SimpleNamespace(forward_batch=None)
+    latent = {}
+
+    def prepare(hidden, residual, batch):
+        latent["batch"] = batch
+        latent["value"] = hidden + batch.value
+        return latent["value"], residual
+
+    def attend(**kwargs):
+        assert kwargs["forward_batch"] is latent["batch"]
+        assert kwargs["hidden_states"] == latent["value"]
+        return latent["value"] * 2
+
+    communicator = SimpleNamespace(prepare_attn=prepare)
+    with patch(
+        "sglang.srt.models.glm5_next.get_tc_piecewise_forward_context",
+        return_value=context,
+    ):
+        for value in (3, 7):
+            context.forward_batch = SimpleNamespace(value=value)
+            result = _bcg_eager_mla_attention_block(
+                communicator, attend, 1, None, None, captured, None, None, None
+            )
+            assert result == ((value + 1) * 2, None, None)
+
+
+def test_mla_bridge_copies_mhc_side_outputs_into_captured_storage():
+    """The captured consumer reads original tensor addresses, not Python fields."""
+    import importlib
+
+    bcg = importlib.import_module(
+        "sglang.srt.model_executor.runner_backend_utils.breakable_cuda_graph.breakable_cuda_graph"
+    )
+    context = SimpleNamespace(forward_batch=SimpleNamespace(value=2))
+    mhc = SimpleNamespace(h_res=None, h_post=None)
+
+    def prepare(hidden, residual, batch):
+        # Deliberately allocate new side outputs on every eager invocation.
+        mhc.h_res = hidden * batch.value
+        mhc.h_post = hidden + batch.value
+        return hidden + 1, residual
+
+    communicator = object.__new__(MHCLayerCommunicator)
+    communicator.prepare_attn = prepare
+    communicator.mhc = mhc
+    graph = SimpleNamespace(_break_fns=[])
+    capture = SimpleNamespace(
+        cuda_graph=graph,
+        _end_current_segment=lambda: None,
+        _begin_new_segment=lambda: None,
+        _barrier_fn=None,
+    )
+    hidden = torch.tensor([1.0, 3.0])
+    with patch(
+        "sglang.srt.models.glm5_next.get_tc_piecewise_forward_context",
+        return_value=context,
+    ):
+        token = bcg._current_capture_var.set(capture)
+        try:
+            captured_output = _bcg_eager_mla_attention_block(
+                communicator,
+                lambda **kwargs: kwargs["hidden_states"] * 2,
+                hidden,
+                None,
+                None,
+                context.forward_batch,
+                None,
+                None,
+                None,
+            )
+            captured_res, captured_post = mhc.h_res, mhc.h_post
+            consumer_addresses = (captured_res.data_ptr(), captured_post.data_ptr())
+        finally:
+            bcg._current_capture_var.reset(token)
+        for value in (7, 3, 11):
+            context.forward_batch = SimpleNamespace(value=value)
+            hidden.add_(1)
+            graph._break_fns[0]()
+            # A graph consumer still reads these original objects after replay.
+            assert consumer_addresses == (
+                captured_res.data_ptr(),
+                captured_post.data_ptr(),
+            )
+            assert mhc.h_res.data_ptr() != captured_res.data_ptr()
+            torch.testing.assert_close(captured_res, hidden * value)
+            torch.testing.assert_close(captured_post, hidden + value)
+            torch.testing.assert_close(captured_output[0], (hidden + 1) * 2)
+
+
+if __name__ == "__main__":
+    import sys
+
+    import pytest
+
+    sys.exit(pytest.main([__file__, "-v"]))
