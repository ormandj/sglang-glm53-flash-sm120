+    int strict_count = 0;
+#pragma unroll 4
+    for (int level = 0; level < 4; ++level) {
+      const int shift = 24 - level * 8;
+      const uint32_t prefix_mask = level == 0 ? 0u : (~0u << (32 - level * 8));
+
+      if (tx < kRadix + 1) histogram[tx] = 0;
+      if (tx == 0) threshold_bin_id = -1;
+      __syncthreads();
+
