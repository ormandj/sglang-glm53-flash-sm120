+        self.requests = []
+        self.max_in_flight = 0
+        self._in_flight = 0
+
+    async def generate_request(self, req, request):
+        self.requests.append(req)
+        self._in_flight += 1
+        self.max_in_flight = max(self.max_in_flight, self._in_flight)
+        await asyncio.sleep(0)
+        self._in_flight -= 1
+        yield {}
