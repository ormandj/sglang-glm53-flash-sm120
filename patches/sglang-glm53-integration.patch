+"""Chunked kpool ragged MQA logits select a correct top-k.
+
+Exercises IndexerKPool._chunked_kpool_logits_topk (and the single-shot
+fp8_mqa_logits + _topk_from_kpool_logits path it must match) on synthetic
+concat-slab layouts mirroring the kpool extend plan.
+
+The fused top-k kernel resolves boundary ties with atomics, so two runs on
+identical inputs may legitimately swap equal-scored boundary candidates;
+bitwise result comparison is not this kernel's contract. Instead every
+result (single-shot and chunked) is verified against a torch recompute of
+the DeepGEMM reference semantics (logits[i, j] = sum_h relu(q_ih . k_j) *
+w_ih, K scale folded in): exact tail tokens, exactly group_topk full
+groups, and the selected groups' ground-truth score multiset must equal
+the true top-k score multiset.
+"""
+
+import unittest
+
+import torch
+
+from sglang.srt.layers.attention.dsa.dsa_indexer import Indexer
+from sglang.srt.layers.attention.dsa.dsa_indexer_kpool import IndexerKPool
+from sglang.test.ci.ci_register import register_cuda_ci
+from sglang.test.test_utils import CustomTestCase
+
+register_cuda_ci(est_time=60, stage="base-b-kernel-unit", runner_config="1-gpu-large")
+
+POOL_SIZE = 4
+INDEX_TOPK = 2048
+GROUP_TOPK = INDEX_TOPK // POOL_SIZE
+NUM_HEADS = 64
+HEAD_DIM = 128
+SLOTS_PER_PAGE = 64
+TOPK_WIDTH = INDEX_TOPK + POOL_SIZE - 1
+
+
+def _has_deep_gemm() -> bool:
+    try:
+        import deep_gemm  # noqa: F401
+
+        return True
+    except ImportError:
+        return False
+
+
+requires_deep_gemm_sm90 = unittest.skipUnless(
+    torch.cuda.is_available()
+    and torch.cuda.get_device_capability()[0] >= 9
+    and _has_deep_gemm(),
+    "requires CUDA SM90+ and deep_gemm",
+)
+
+
+def _fake_indexer() -> IndexerKPool:
+    indexer = object.__new__(IndexerKPool)
+    indexer.index_kpool = POOL_SIZE
+    indexer.index_topk = INDEX_TOPK
+    return indexer
+
+
+def _build_layout(seed: int, req_specs, permute: bool = False):
+    """Synthetic kpool extend-plan layout.
+
+    req_specs: list of (final_pool_len, q_len). Each request gets a
+    page-aligned slab in the shared concat-K buffer; its q rows have causally
+    growing pooled lengths ending at final_pool_len, with a rotating raw-token
+    tail. Every pooled length stays above GROUP_TOPK so real selection runs.
+    """
+    torch.manual_seed(seed)
+    device = "cuda"
+    ks_rows = []
+    ke_rows = []
+    pool_len_rows = []
+    seq_len_rows = []
+    req_of_row = []
+    slab_start = 0
+    for req_idx, (final_pool_len, q_len) in enumerate(req_specs):
+        assert final_pool_len - q_len + 1 > GROUP_TOPK
+        for j in range(q_len):
+            pool_len = final_pool_len - q_len + 1 + j
+            tail = (slab_start + j) % POOL_SIZE
+            ks_rows.append(slab_start)
+            ke_rows.append(slab_start + pool_len)
+            pool_len_rows.append(pool_len)
+            seq_len_rows.append(pool_len * POOL_SIZE + tail)
+            req_of_row.append(req_idx)
+        pages = (final_pool_len + SLOTS_PER_PAGE - 1) // SLOTS_PER_PAGE
+        slab_start += pages * SLOTS_PER_PAGE
+    total_k = slab_start
+    n_rows = len(ks_rows)
+
+    order = torch.arange(n_rows, device=device)
+    if permute:
+        order = torch.randperm(n_rows, device=device)
+
+    def _rows(values, dtype):
+        return torch.tensor(values, dtype=dtype, device=device)[order].contiguous()
+
+    q_fp8 = (
+        torch.randn(n_rows, NUM_HEADS, HEAD_DIM, device=device)[order]
+        .contiguous()
+        .to(torch.float8_e4m3fn)
+    )
+    weights = torch.rand(n_rows, NUM_HEADS, device=device)[order].contiguous()
+    k_fp8 = torch.randn(total_k, HEAD_DIM, device=device).to(torch.float8_e4m3fn)
+    k_scale = torch.rand(total_k, device=device) + 0.5
+    return dict(
+        q_fp8=q_fp8,
+        weights=weights,
+        kv_fp8=(k_fp8, k_scale),
+        ks=_rows(ks_rows, torch.int32),
+        ke=_rows(ke_rows, torch.int32),
+        pool_lens=_rows(pool_len_rows, torch.int32),
+        seq_lens=_rows(seq_len_rows, torch.int32),
+        req_of_row=_rows(req_of_row, torch.int32),
+        seq_len_rows=seq_len_rows,
+        n_rows=n_rows,
+        n_reqs=len(req_specs),
+        total_k=total_k,
+    )
+
+
+def _ground_truth_logits(layout) -> torch.Tensor:
+    """DeepGEMM reference semantics in torch fp32 (K scale folded in)."""
+    q = layout["q_fp8"].float()
+    k_fp8, k_scale = layout["kv_fp8"]
+    k = k_fp8.float() * k_scale[:, None]
+    per_head = torch.einsum("mhd,nd->mhn", q, k).relu()
+    return torch.einsum("mhn,mh->mn", per_head, layout["weights"])
+
+
+@requires_deep_gemm_sm90
+class TestDsaKpoolChunkedLogits(CustomTestCase):
+    REQ_SPECS = [(1400, 96), (2500, 160), (700, 61)]
+
+    def setUp(self):
+        # The budget cache is process-global and shared across both indexer
+        # classes; keep tests independent of each other and of prior imports.
+        IndexerKPool._mqa_logits_budget_bytes.clear()
+
+    def _single_shot(self, layout, page_table, topk_offsets, row_index, out_rows):
+        import deep_gemm
+
+        indexer = _fake_indexer()
