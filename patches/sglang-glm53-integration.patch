+++ b/test/registered/kernel/attention/test_dsa_kpool_chunked_logits.py
@@ -0,0 +1,407 @@
+"""Chunked kpool ragged MQA logits select a correct top-k.
+
+Exercises IndexerKPool._chunked_kpool_logits_topk (and the single-shot
+fp8_mqa_logits + _topk_from_kpool_logits path it must match) on synthetic
+concat-slab layouts mirroring the kpool extend plan.
+
+The fused top-k kernel resolves boundary ties with atomics, so two runs on
+identical inputs may legitimately swap equal-scored boundary candidates;
+bitwise result comparison is not this kernel's contract. Instead every
+result (single-shot and chunked) is verified against a torch recompute of
+the DeepGEMM reference semantics (logits[i, j] = sum_h relu(q_ih . k_j) *
+w_ih, K scale folded in): exact tail tokens, exactly group_topk full
+groups, and the selected groups' ground-truth score multiset must equal
+the true top-k score multiset.
+"""
+
+import unittest
+
+import torch
+
+from sglang.srt.layers.attention.dsa.dsa_indexer import Indexer
+from sglang.srt.layers.attention.dsa.dsa_indexer_kpool import IndexerKPool
+from sglang.test.ci.ci_register import register_cuda_ci
+from sglang.test.test_utils import CustomTestCase
+
+register_cuda_ci(est_time=60, stage="base-b-kernel-unit", runner_config="1-gpu-large")
+
+POOL_SIZE = 4
+INDEX_TOPK = 2048
+GROUP_TOPK = INDEX_TOPK // POOL_SIZE
+NUM_HEADS = 64
+HEAD_DIM = 128
+SLOTS_PER_PAGE = 64
+TOPK_WIDTH = INDEX_TOPK + POOL_SIZE - 1
+
+
+def _has_deep_gemm() -> bool:
+    try:
+        import deep_gemm  # noqa: F401
+
+        return True
+    except ImportError:
+        return False
+
+
+requires_deep_gemm_sm90 = unittest.skipUnless(
+    torch.cuda.is_available()
+    and torch.cuda.get_device_capability()[0] >= 9
+    and _has_deep_gemm(),
+    "requires CUDA SM90+ and deep_gemm",
+)
+
+
+def _fake_indexer() -> IndexerKPool:
+    indexer = object.__new__(IndexerKPool)
+    indexer.index_kpool = POOL_SIZE
+    indexer.index_topk = INDEX_TOPK
+    return indexer
+
+
+def _build_layout(seed: int, req_specs, permute: bool = False):
+    """Synthetic kpool extend-plan layout.
+
+    req_specs: list of (final_pool_len, q_len). Each request gets a
+    page-aligned slab in the shared concat-K buffer; its q rows have causally
+    growing pooled lengths ending at final_pool_len, with a rotating raw-token
+    tail. Every pooled length stays above GROUP_TOPK so real selection runs.
+    """
+    torch.manual_seed(seed)
+    device = "cuda"
+    ks_rows = []
+    ke_rows = []
+    pool_len_rows = []
+    seq_len_rows = []
+    req_of_row = []
+    slab_start = 0
+    for req_idx, (final_pool_len, q_len) in enumerate(req_specs):
+        assert final_pool_len - q_len + 1 > GROUP_TOPK
+        for j in range(q_len):
+            pool_len = final_pool_len - q_len + 1 + j
+            tail = (slab_start + j) % POOL_SIZE
+            ks_rows.append(slab_start)
+            ke_rows.append(slab_start + pool_len)
+            pool_len_rows.append(pool_len)
+            seq_len_rows.append(pool_len * POOL_SIZE + tail)
+            req_of_row.append(req_idx)
+        pages = (final_pool_len + SLOTS_PER_PAGE - 1) // SLOTS_PER_PAGE
+        slab_start += pages * SLOTS_PER_PAGE
+    total_k = slab_start
+    n_rows = len(ks_rows)
+
+    order = torch.arange(n_rows, device=device)
+    if permute:
+        order = torch.randperm(n_rows, device=device)
+
+    def _rows(values, dtype):
+        return torch.tensor(values, dtype=dtype, device=device)[order].contiguous()
+
+    q_fp8 = (
+        torch.randn(n_rows, NUM_HEADS, HEAD_DIM, device=device)[order]
+        .contiguous()
+        .to(torch.float8_e4m3fn)
+    )
+    weights = torch.rand(n_rows, NUM_HEADS, device=device)[order].contiguous()
+    k_fp8 = torch.randn(total_k, HEAD_DIM, device=device).to(torch.float8_e4m3fn)
+    k_scale = torch.rand(total_k, device=device) + 0.5
+    return dict(
+        q_fp8=q_fp8,
+        weights=weights,
+        kv_fp8=(k_fp8, k_scale),
+        ks=_rows(ks_rows, torch.int32),
+        ke=_rows(ke_rows, torch.int32),
+        pool_lens=_rows(pool_len_rows, torch.int32),
+        seq_lens=_rows(seq_len_rows, torch.int32),
+        req_of_row=_rows(req_of_row, torch.int32),
+        seq_len_rows=seq_len_rows,
+        n_rows=n_rows,
+        n_reqs=len(req_specs),
+        total_k=total_k,
+    )
+
+
+def _ground_truth_logits(layout) -> torch.Tensor:
+    """DeepGEMM reference semantics in torch fp32 (K scale folded in)."""
+    q = layout["q_fp8"].float()
+    k_fp8, k_scale = layout["kv_fp8"]
+    k = k_fp8.float() * k_scale[:, None]
+    per_head = torch.einsum("mhd,nd->mhn", q, k).relu()
+    return torch.einsum("mhn,mh->mn", per_head, layout["weights"])
+
+
+@requires_deep_gemm_sm90
+class TestDsaKpoolChunkedLogits(CustomTestCase):
+    REQ_SPECS = [(1400, 96), (2500, 160), (700, 61)]
+
+    def setUp(self):
+        # The budget cache is process-global and shared across both indexer
+        # classes; keep tests independent of each other and of prior imports.
+        IndexerKPool._mqa_logits_budget_bytes.clear()
+
+    def _single_shot(self, layout, page_table, topk_offsets, row_index, out_rows):
+        import deep_gemm
+
+        indexer = _fake_indexer()
+        logits = deep_gemm.fp8_mqa_logits(
+            layout["q_fp8"].contiguous(),
+            layout["kv_fp8"],
+            layout["weights"].contiguous(),
+            layout["ks"],
+            layout["ke"],
+            clean_logits=True,
+        )
+        return indexer._topk_from_kpool_logits(
+            logits,
+            layout["pool_lens"],
+            seq_lens=layout["seq_lens"],
+            page_table=page_table,
+            topk_offsets=topk_offsets,
+            row_starts=layout["ks"],
+            out_rows=out_rows,
+            page_table_row_index=row_index,
+        )
+
+    def _chunked(self, layout, page_table, topk_offsets, row_index, out_rows, max_rows):
+        indexer = _fake_indexer()
+        out = torch.full((out_rows, TOPK_WIDTH), -1, dtype=torch.int32, device="cuda")
+        indexer._chunked_kpool_logits_topk(
+            q_fp8=layout["q_fp8"],
+            kv_fp8=layout["kv_fp8"],
+            weights=layout["weights"],
+            ks=layout["ks"],
+            ke=layout["ke"],
+            topk_row_starts=layout["ks"],
+            pool_lens=layout["pool_lens"],
+            seq_lens=layout["seq_lens"],
+            page_table=page_table,
+            topk_offsets=topk_offsets,
+            page_table_row_index=row_index,
+            out=out,
+            out_start=0,
+            max_rows=max_rows,
+        )
+        return out
+
+    def _verify_selection(self, sel, layout, gt_logits, inverse_fn, label):
+        n_rows = layout["n_rows"]
+        for r in range(n_rows):
+            ks = int(layout["ks"][r])
+            ke = int(layout["ke"][r])
+            pool_len = ke - ks
+            tail_count = int(layout["seq_lens"][r]) % POOL_SIZE
+            row = sel[r]
+            valid = row[row >= 0]
+            self.assertEqual(
+                valid.numel(),
+                GROUP_TOPK * POOL_SIZE + tail_count,
+                f"{label}: row {r} selected count",
+            )
+            raw = inverse_fn(r, valid)
+            tails = raw[raw >= pool_len * POOL_SIZE]
+            expected_tails = torch.arange(
+                pool_len * POOL_SIZE,
+                pool_len * POOL_SIZE + tail_count,
+                dtype=raw.dtype,
+                device=raw.device,
+            )
+            self.assertTrue(
+                torch.equal(torch.sort(tails).values, expected_tails),
+                f"{label}: row {r} tail tokens",
+            )
+            hist = raw[raw < pool_len * POOL_SIZE]
+            self.assertTrue(bool((hist >= 0).all()), f"{label}: row {r} range")
+            groups, counts = torch.unique(hist // POOL_SIZE, return_counts=True)
+            self.assertEqual(groups.numel(), GROUP_TOPK, f"{label}: row {r} groups")
+            self.assertTrue(
+                bool((counts == POOL_SIZE).all()),
+                f"{label}: row {r} partial group expansion",
+            )
+            scores = gt_logits[r, ks:ke]
+            sel_scores = torch.sort(scores[groups.long()]).values
+            top_scores = torch.sort(torch.topk(scores, GROUP_TOPK).values).values
+            torch.testing.assert_close(
+                sel_scores,
+                top_scores,
+                rtol=1e-5,
+                atol=1e-3,
+                msg=f"{label}: row {r} selection is not a true top-k",
+            )
+
+    def _run_case(self, page_table_kind, permute=False, out_rows_extra=0, seed=7):
+        layout = _build_layout(seed, self.REQ_SPECS, permute=permute)
+        n_rows = layout["n_rows"]
+        out_rows = n_rows + out_rows_extra
+        gt_logits = _ground_truth_logits(layout)
+        page_table = None
+        topk_offsets = None
+        row_index = None
+        if page_table_kind == "ragged":
+            base = torch.cumsum(layout["seq_lens"].to(torch.int64), dim=0)
+            topk_offsets = torch.cat(
+                [
+                    torch.zeros(1, dtype=torch.int64, device="cuda"),
+                    base[:-1],
+                ]
+            ).to(torch.int32)
+
+            def inverse_fn(r, tokens):
+                return tokens - topk_offsets[r]
+
+        elif page_table_kind == "paged":
+            max_seq = max(layout["seq_len_rows"]) + POOL_SIZE
+            flat = torch.randperm(
+                layout["n_reqs"] * max_seq, dtype=torch.int32, device="cuda"
+            )
+            page_table = flat.reshape(layout["n_reqs"], max_seq)
+            row_index = layout["req_of_row"]
+            inverse = torch.empty_like(flat)
+            inverse[flat.long()] = torch.arange(
+                flat.numel(), dtype=torch.int32, device="cuda"
+            )
+
+            def inverse_fn(r, tokens):
+                pos = inverse[tokens.long()]
+                req = int(layout["req_of_row"][r])
+                self.assertTrue(
+                    bool((pos // max_seq == req).all()),
+                    f"row {r} maps into another request's page table row",
+                )
+                return pos % max_seq
+
+        else:
+
+            def inverse_fn(r, tokens):
+                return tokens
+
+        ref = self._single_shot(layout, page_table, topk_offsets, row_index, out_rows)
+        self._verify_selection(ref, layout, gt_logits, inverse_fn, "single-shot")
+        for max_rows in (37, n_rows, 1 + n_rows // 2):
+            got = self._chunked(
+                layout, page_table, topk_offsets, row_index, out_rows, max_rows
+            )
+            self._verify_selection(
+                got, layout, gt_logits, inverse_fn, f"chunked[{max_rows}]"
+            )
+            if out_rows_extra:
+                self.assertTrue(torch.all(got[n_rows:] == -1))
+        if out_rows_extra:
+            self.assertTrue(torch.all(ref[n_rows:] == -1))
+
+    def test_raw_indices(self):
+        self._run_case(None)
+
+    def test_ragged_offsets(self):
+        self._run_case("ragged")
+
+    def test_paged_shared_table_with_row_index(self):
+        self._run_case("paged")
+
+    def test_permuted_rows_like_cp_row_select(self):
+        self._run_case("ragged", permute=True, seed=11)
+
+    def test_pad_rows_stay_negative_one(self):
+        self._run_case("ragged", out_rows_extra=5)
+
+    def test_single_row_chunks(self):
+        layout = _build_layout(13, [(600, 9)])
+        gt_logits = _ground_truth_logits(layout)
+        got = self._chunked(layout, None, None, None, layout["n_rows"], max_rows=1)
+        self._verify_selection(got, layout, gt_logits, lambda r, t: t, "chunked[1]")
+
+    def test_legacy_style_out_start_and_row_sliced_page_table(self):
+        # Legacy loop shape: one request, ks == 0, per-row expanded page
+        # table (no row index), topk_row_starts=None, writes at an offset
+        # into a larger result buffer.
