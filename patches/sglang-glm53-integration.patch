+def _signal_serving_started(tokenizer_manager, event_loop=None) -> bool:
+    """Deliver the serving-started mark to every scheduler rank.
+
+    Called from the warmup thread once every request-driven warmup (custom
+    ``--warmups`` in the app lifespan, then the default warmup request) has
+    finished, and before ``ServerStatus.Up`` is published: kernels the warmups
+    deliberately loaded are not late loads, everything after this point is.
+    The control request runs on the tokenizer manager's event loop and is
+    awaited from here. Two attempts; if both fail the error is logged and the
+    schedulers stay unarmed for this process (diagnostics off, never false
+    positives), readiness is not held back. Returns whether it was delivered.
+    """
