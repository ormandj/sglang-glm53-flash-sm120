+        tail_positions = all_positions[-8:] if invalid_count > 8 else None
+        positions_list = positions.detach().cpu().tolist()
+        values = flat[positions].detach().cpu().tolist()
+        tail_positions_list = (
+            tail_positions.detach().cpu().tolist()
+            if tail_positions is not None
+            else None
+        )
+        tail_values = (
+            flat[tail_positions].detach().cpu().tolist()
+            if tail_positions is not None
+            else None
+        )
+    except RuntimeError as error:
+        invalid_count = "unavailable"
+        positions_list = f"unavailable ({type(error).__name__})"
+        values = f"unavailable ({type(error).__name__})"
+        tail_positions_list = None
+        tail_values = None
+    raise AssertionError(
+        f"index outside [{low}, {high}) at {msg}: "
+        f"dtype={flat.dtype} numel={flat.numel()} min={minimum} max={maximum} "
+        f"invalid_count={invalid_count} "
+        f"positions={positions_list} values={values} "
+        f"tail_positions={tail_positions_list} "
+        f"tail_values={tail_values}"
+    )
