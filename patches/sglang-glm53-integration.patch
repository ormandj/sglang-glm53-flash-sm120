+class _RowPaddedLMHeadMethod:
+    """Apply a block-FP8 head whose rows were padded to a 128 multiple."""
+
+    def __init__(self, inner, rows: int):
+        self.inner = inner
+        self.rows = rows
+
+    def apply(self, layer, x, bias=None):
+        out = self.inner.apply(layer, x, bias)
+        if out.shape[-1] != self.rows:
+            out = out[..., : self.rows].contiguous()
+        return out
+
+
+def _block_quant_fp8_chunked(
+    weight: torch.Tensor, block: int = 128, rows_per_chunk: int = 1024
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """Quantize a head in row chunks to bound temporary device memory."""
+    n, k = weight.shape
+    assert n % block == 0 and k % block == 0 and rows_per_chunk % block == 0
+    fp8_max = torch.finfo(torch.float8_e4m3fn).max
+    quantized = torch.empty((n, k), dtype=torch.float8_e4m3fn, device=weight.device)
+    scales = torch.empty((n // block, k // block), dtype=torch.float32, device=weight.device)
+    for start in range(0, n, rows_per_chunk):
+        end = min(n, start + rows_per_chunk)
+        chunk = weight[start:end].float().view((end - start) // block, block, k // block, block)
+        maximum = chunk.abs().amax(dim=(1, 3), keepdim=True).clamp_(min=1e-4)
+        scale = maximum / fp8_max
+        quantized[start:end] = (chunk / scale).reshape(end - start, k).to(torch.float8_e4m3fn)
+        scales[start // block : end // block] = scale.view((end - start) // block, k // block)
+    return quantized, scales
