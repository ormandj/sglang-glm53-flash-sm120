@@ -0,0 +1,231 @@
+"""Unit tests for the HTTP server's serving-started signal, no server.
+
+The readiness contract: every request-driven warmup finishes, the schedulers
+are told (and the call is awaited), and only then does ``ServerStatus.Up``
+make ``/health`` answer 200, on the warmup path and the skip-warmup path.
+"""
+
+import asyncio
+import threading
+import unittest
+from types import SimpleNamespace
+from unittest.mock import patch
+
+from sglang.srt.entrypoints import http_server
+from sglang.srt.entrypoints.http_server import (
+    _signal_serving_started,
+    _wait_and_warmup,
+)
+from sglang.srt.managers.io_struct import MarkServingStartedReqOutput
+from sglang.srt.managers.tokenizer_manager import ServerStatus
+from sglang.srt.runtime_context import get_context
+from sglang.test.ci.ci_register import register_cpu_ci
+
+register_cpu_ci(est_time=8, suite="base-a-test-cpu")
+
+MOD = "sglang.srt.entrypoints.http_server"
+
+
+def _server_args():
+    return SimpleNamespace(
+        checkpoint_engine_wait_weights_before_ready=False,
+        is_ep_scale_joiner=False,
+        delete_ckpt_after_loading=False,
+        debug_tensor_dump_input_file=None,
+    )
+
+
+class _LoopThread:
+    """A real event loop on a background thread, like uvicorn's."""
+
+    def __init__(self):
+        self.loop = asyncio.new_event_loop()
+        self.thread = threading.Thread(target=self.loop.run_forever, daemon=True)
+        self.thread.start()
+
+    def stop(self):
+        self.loop.call_soon_threadsafe(self.loop.stop)
+        self.thread.join(timeout=5)
+        self.loop.close()
+
+
+class TestSignalServingStarted(unittest.TestCase):
+    def setUp(self):
+        self.runner = _LoopThread()
+        self.addCleanup(self.runner.stop)
+
+    def test_runs_the_control_request_on_the_given_loop_and_waits(self):
+        seen_loops = []
+
+        class TM:
+            event_loop = None
+
+            async def mark_serving_started(self):
+                seen_loops.append(asyncio.get_running_loop())
+                await asyncio.sleep(0.01)
+                return [
+                    MarkServingStartedReqOutput(
+                        marked=True, signals_received=1, signals_expected=1
+                    )
+                ]
+
+        self.assertTrue(_signal_serving_started(TM(), self.runner.loop))
+        # The reply arrived before the call returned, on the loop we gave it.
+        self.assertEqual(seen_loops, [self.runner.loop])
+
+    def test_falls_back_to_the_tokenizer_managers_loop(self):
+        calls = []
+
+        class TM:
+            event_loop = self.runner.loop
+
+            async def mark_serving_started(self):
+                calls.append(1)
+                return []
+
+        self.assertTrue(_signal_serving_started(TM()))
+        self.assertEqual(calls, [1])
+
+    def test_a_failure_is_retried_once_then_logged_at_error(self):
+        attempts = []
+
+        class TM:
+            async def mark_serving_started(self):
+                attempts.append(1)
+                raise RuntimeError("scheduler unreachable")
+
+        with self.assertLogs(MOD, level="ERROR") as cm:
+            delivered = _signal_serving_started(TM(), self.runner.loop)
+
+        self.assertFalse(delivered)
+        self.assertEqual(len(attempts), 2)
+        self.assertTrue(any("attempt 1 failed" in line for line in cm.output))
+        self.assertTrue(any("attempt 2 failed" in line for line in cm.output))
+        self.assertTrue(any("stay unarmed" in line for line in cm.output))
+
+    def test_a_transient_failure_succeeds_on_the_second_attempt(self):
+        attempts = []
+
+        class TM:
+            async def mark_serving_started(self):
+                attempts.append(1)
+                if len(attempts) == 1:
+                    raise RuntimeError("transient")
+                return []
+
+        with self.assertLogs(MOD, level="ERROR"):
+            self.assertTrue(_signal_serving_started(TM(), self.runner.loop))
+        self.assertEqual(len(attempts), 2)
+
+    def test_a_timeout_is_a_failure(self):
+        class TM:
+            async def mark_serving_started(self):
+                await asyncio.sleep(60)
+
+        with patch(f"{MOD}.SERVING_STARTED_SIGNAL_TIMEOUT_SECS", 0.05):
+            with self.assertLogs(MOD, level="ERROR"):
+                self.assertFalse(_signal_serving_started(TM(), self.runner.loop))
+
+    def test_no_loop_is_a_logged_failure(self):
+        class TM:
+            event_loop = None
+
+        with self.assertLogs(MOD, level="ERROR") as cm:
+            self.assertFalse(_signal_serving_started(TM(), None))
+        self.assertTrue(any("no event loop" in line for line in cm.output))
+
+
+class TestWaitAndWarmupOrdering(unittest.TestCase):
+    """The signal is sent after the warmups and before ServerStatus.Up."""
+
+    def setUp(self):
+        self.tm = SimpleNamespace(server_status=ServerStatus.Starting)
+        self.events = []
+
+        def signal(tokenizer_manager, event_loop=None):
+            self.assertIs(tokenizer_manager, self.tm)
+            self.events.append(("signal", tokenizer_manager.server_status))
+            return True
+
+        for p in (
+            patch(f"{MOD}._global_state", SimpleNamespace(tokenizer_manager=self.tm)),
+            patch(f"{MOD}._signal_serving_started", side_effect=signal),
+            patch(f"{MOD}._freeze_gc_after_server_warmup"),
+        ):
+            p.start()
+            self.addCleanup(p.stop)
+
+    def _publish(self, skip_server_warmup):
+        override = get_context().override_server_args(
+            skip_server_warmup=skip_server_warmup
+        )
+        override.install()
+        self.addCleanup(override.restore)
+
+    def _warmup(self, result):
+        def execute(server_args):
+            self.events.append(("warmup", self.tm.server_status))
+            return result
+
+        return execute
+
+    def test_warmup_path_signals_after_warmup_and_before_up(self):
+        self._publish(skip_server_warmup=False)
+        _wait_and_warmup(
+            _server_args(), execute_warmup_func=self._warmup(ServerStatus.Up)
+        )
+        self.assertEqual(
+            self.events,
+            [("warmup", ServerStatus.Starting), ("signal", ServerStatus.Starting)],
+        )
+        self.assertEqual(self.tm.server_status, ServerStatus.Up)
+
+    def test_skip_warmup_path_still_signals_before_up(self):
+        self._publish(skip_server_warmup=True)
+        _wait_and_warmup(
+            _server_args(), execute_warmup_func=self._warmup(ServerStatus.Up)
+        )
+        self.assertEqual(self.events, [("signal", ServerStatus.Starting)])
+        self.assertEqual(self.tm.server_status, ServerStatus.Up)
+
+    def test_a_failed_pd_warmup_signals_and_reports_unhealthy(self):
+        self._publish(skip_server_warmup=False)
+        _wait_and_warmup(
+            _server_args(), execute_warmup_func=self._warmup(ServerStatus.UnHealthy)
+        )
+        self.assertEqual([e[0] for e in self.events], ["warmup", "signal"])
+        self.assertEqual(self.tm.server_status, ServerStatus.UnHealthy)
+
+    def test_a_plain_true_from_a_custom_warmup_means_up(self):
+        self._publish(skip_server_warmup=False)
+        _wait_and_warmup(_server_args(), execute_warmup_func=self._warmup(True))
+        self.assertEqual([e[0] for e in self.events], ["warmup", "signal"])
+        self.assertEqual(self.tm.server_status, ServerStatus.Up)
+
+    def test_a_fatal_warmup_neither_signals_nor_reports_ready(self):
+        self._publish(skip_server_warmup=False)
+        _wait_and_warmup(_server_args(), execute_warmup_func=self._warmup(False))
+        self.assertEqual([e[0] for e in self.events], ["warmup"])
+        self.assertEqual(self.tm.server_status, ServerStatus.Starting)
+
+    def test_the_loop_is_forwarded_to_the_signal(self):
+        self._publish(skip_server_warmup=True)
+        loop = asyncio.new_event_loop()
+        self.addCleanup(loop.close)
+        seen = []
+        http_server._signal_serving_started.side_effect = lambda tm, event_loop=None: (
+            seen.append(event_loop) or True
+        )
+        _wait_and_warmup(_server_args(), event_loop=loop)
+        self.assertEqual(seen, [loop])
+
+    def test_a_failed_signal_does_not_hold_back_readiness(self):
+        # Failure semantics: logged, schedulers stay unarmed, server still up.
+        self._publish(skip_server_warmup=True)
+        http_server._signal_serving_started.side_effect = lambda *a, **k: False
+        _wait_and_warmup(_server_args())
+        self.assertEqual(self.tm.server_status, ServerStatus.Up)
+
+
+if __name__ == "__main__":
+    unittest.main()
