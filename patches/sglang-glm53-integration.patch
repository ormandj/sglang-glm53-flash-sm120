+"""Unit tests for the MarkServingStarted control request, no server, no GPU.
+
+Covers the wire round trip, the tokenizer-side fan-out, the scheduler handler
+counting signals up to the number of tokenizer workers, and the launch-path
+predicate that decides whether a scheduler marks at init instead.
+"""
+
+import asyncio
+import unittest
+from unittest.mock import patch
+
+from sglang.test.ci.ci_register import register_cpu_ci
+from sglang.test.test_utils import maybe_stub_sgl_kernel
+
+maybe_stub_sgl_kernel()
+
+from sglang.srt.environ import envs
+from sglang.srt.managers.communicator import FanOutCommunicator
+from sglang.srt.managers.io_struct import (
+    MarkServingStartedReqInput,
+    MarkServingStartedReqOutput,
+    msgpack_decode,
+    msgpack_encode,
+)
+from sglang.srt.managers.scheduler import Scheduler
+from sglang.srt.managers.tokenizer_control_mixin import (
+    _COMMUNICATOR_SPECS,
+    TokenizerControlMixin,
+)
+from sglang.srt.runtime_context import get_context
+from sglang.srt.utils import triton_load_watch
+from sglang.srt.utils.triton_load_watch import expected_serving_started_signals
+
+register_cpu_ci(est_time=8, suite="base-a-test-cpu")
+
+SCHEDULER_MOD = "sglang.srt.managers.scheduler"
+
+
+class TestWireRoundTrip(unittest.TestCase):
+    def test_input_carries_its_worker_route(self):
+        req = MarkServingStartedReqInput(http_worker_ipc="ipc:///tmp/worker-3")
+        decoded = msgpack_decode(msgpack_encode(req))
+        self.assertIsInstance(decoded, MarkServingStartedReqInput)
+        self.assertEqual(decoded.http_worker_ipc, "ipc:///tmp/worker-3")
+
+    def test_output_round_trips_every_field(self):
+        out = MarkServingStartedReqOutput(
+            marked=False, signals_received=1, signals_expected=2, rid="r"
+        )
+        decoded = msgpack_decode(msgpack_encode(out))
+        self.assertIsInstance(decoded, MarkServingStartedReqOutput)
+        self.assertEqual(
+            (decoded.marked, decoded.signals_received, decoded.signals_expected),
+            (False, 1, 2),
+        )
+
+
+class TestTokenizerFanOut(unittest.TestCase):
+    def test_a_communicator_is_declared_for_the_reply(self):
+        self.assertIn(
+            ("mark_serving_started", MarkServingStartedReqOutput),
+            [spec[:2] for spec in _COMMUNICATOR_SPECS],
+        )
+
+    def test_mark_serving_started_fans_out_and_collects_every_rank(self):
+        """The mixin sends one MarkServingStartedReqInput and waits for one
+        reply per DP rank, like every other control request."""
+
+        class FakeTokenizerManager(TokenizerControlMixin):
+            def __init__(self):
+                self.sent = []
+                self.mark_serving_started_communicator = FanOutCommunicator(
+                    self.sent.append, fan_out=2
+                )
+
+            def auto_create_handle_loop(self):
+                pass
+
+        async def scenario():
+            tm = FakeTokenizerManager()
+            task = asyncio.create_task(tm.mark_serving_started())
+            await asyncio.sleep(0)
+            self.assertEqual(len(tm.sent), 1)
+            self.assertIsInstance(tm.sent[0], MarkServingStartedReqInput)
+            comm = tm.mark_serving_started_communicator
+            comm.handle_recv(
+                MarkServingStartedReqOutput(
+                    marked=True, signals_received=1, signals_expected=1
+                )
+            )
+            await asyncio.sleep(0)
+            self.assertFalse(task.done())
+            comm.handle_recv(
+                MarkServingStartedReqOutput(
+                    marked=True, signals_received=1, signals_expected=1
+                )
+            )
+            return await task
+
+        replies = asyncio.run(scenario())
+        self.assertEqual(len(replies), 2)
+        self.assertTrue(all(r.marked for r in replies))
+
+
+class TestExpectedSignals(unittest.TestCase):
+    """The single helper deciding who marks: one signal per tokenizer worker,
+    none (mark at init) when no Python TokenizerManager exists."""
+
+    def _with_workers(self, n):
+        override = get_context().override_server_args(tokenizer_worker_num=n)
+        override.install()
+        self.addCleanup(override.restore)
+
+    def test_one_signal_per_tokenizer_worker(self):
+        self._with_workers(1)
+        self.assertEqual(expected_serving_started_signals(), 1)
+
+    def test_multiple_tokenizer_workers(self):
+        self._with_workers(3)
+        self.assertEqual(expected_serving_started_signals(), 3)
+
+    def test_rust_server_never_receives_one(self):
+        self._with_workers(3)
+        with envs.SGLANG_RUST_SERVER.override(True):
+            self.assertEqual(expected_serving_started_signals(), 0)
