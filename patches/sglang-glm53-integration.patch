+    assert len(capture_owners) == 1
+    torch.testing.assert_close(capture_owners[0], expected_replay, rtol=1e-5, atol=1e-6)
+
+
+@pytest.mark.skipif(not torch.cuda.is_available(), reason="CUDA is required")
