+def are_linear_prefixes_unquantized(
+    quant_config: Optional[QuantizationConfig],
+    linear_specs: Iterable[Tuple[str, type[torch.nn.Module]]],
+) -> bool:
+    """Whether every named linear layer would be built unquantized.
+
+    A model-level ``quant_config`` only says the checkpoint carries *some*
+    quantized weights, not that any given layer is one of them -- FP8
+    checkpoints routinely quantize the experts and leave attention in BF16.
+    Callers that swap in a hand-fused module the quant methods cannot feed must
+    therefore ask per layer instead of testing ``quant_config is None``, so
+    resolve each prefix the way the real layer would and accept only
+    ``None`` / ``UnquantizedLinearMethod``.
+    """
+    if quant_config is None:
+        return True
+
+    from sglang.srt.layers.linear import LinearBase
+    from sglang.srt.layers.quantization.unquant import UnquantizedLinearMethod
+
+    for prefix, linear_cls in linear_specs:
+        # Keep the real class identity because compressed-tensors configs may
+        # target class names as well as module paths. Calling only the base
+        # initializer allocates no weights but supplies the common attributes
+        # other quantization configs expect from a linear layer. It cannot
+        # recurse because the probe itself has no quantization config.
+        probe = linear_cls.__new__(linear_cls)
+        LinearBase.__init__(probe, input_size=1, output_size=1, quant_config=None)
+        quant_method = quant_config.get_quant_method(probe, prefix=prefix)
+        if quant_method is not None and not isinstance(
+            quant_method, UnquantizedLinearMethod
+        ):
+            return False
+    return True
+
