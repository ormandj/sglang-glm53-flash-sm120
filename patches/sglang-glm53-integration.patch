@@ -15,10 +15,24 @@ with less than 1 GiB of free device memory. Set
 instead — for CI recipes that assert full startup warmup coverage. The hooks
 only run for compilation and first-use loads, so steady-state cost is zero.
 
-Note: request-driven warmup (``--warmups``, the server warmup request) runs
-*after* ``mark_serving_started()`` and is subject to the same diagnostics;
-crash mode is only meant for deployments whose kernels are fully pre-loaded at
-engine init.
+``install()`` runs at scheduler init so every load is observed, but nothing is
+reported until ``mark_serving_started()``. Who calls the mark depends on the
+launch path (``expected_serving_started_signals``):
+
+* HTTP server (``launch_server``, including native ``--grpc-port`` and PD
+  prefill/decode): each tokenizer worker sends ``MarkServingStartedReqInput``
+  after its request-driven warmups (the default warmup request and
+  ``--warmups``) finish and before it reports ready, so loads those warmups
+  deliberately trigger are not reported. A scheduler marks once every
+  tokenizer worker has signalled.
+* ``Engine`` (and the legacy SMG gRPC server, which builds one): sends the
+  signal right after init, since it runs no request-driven warmups.
+* Embedded Rust server (``SGLANG_RUST_SERVER=1``): there is no Python
+  ``TokenizerManager`` to send it, so the scheduler marks at init.
+
+Crash mode is meant for deployments whose kernels are fully loaded by the end
+of warmup (``--warmups serving_coverage`` drives the real serving path for
+that purpose).
 """
 
 from __future__ import annotations
@@ -37,6 +51,22 @@ _prev_compile_listener = None
 _installed = False
 
 
+def expected_serving_started_signals() -> int:
+    """How many ``MarkServingStartedReqInput`` signals a scheduler waits for.
+
+    One per tokenizer worker: every worker runs its own warmups and sends its
+    own signal, and the mark must wait for the last of them. ``0`` means no
+    signal will ever arrive, the embedded Rust server has no Python
+    ``TokenizerManager``, and the scheduler marks at init instead. Derived
+    from the published config only, so every rank computes the same answer.
+    """
+    from sglang.srt.runtime_context import get_serving
+
+    if envs.SGLANG_RUST_SERVER.get():
+        return 0
+    return max(1, int(get_serving().tokenizer_worker_num or 1))
+
+
 def install() -> None:
     """Install the diagnostics (idempotent; chains pre-existing hooks)."""
     global _installed, _prev_compile_listener
