+
+    def test_multi_chunk_phases_are_skipped_with_a_reason(self):
+        tm = FakeTokenizerManager(max_req_input_len=1024)
+        with self.assertLogs(warmup_module.logger, level="INFO") as cm:
+            phases = _phases(tm)
+        self.assertNotIn("cold-cohort", phases)
