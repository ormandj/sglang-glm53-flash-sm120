--- /dev/null
+++ b/test/registered/unit/mem_cache/test_unified_tree_split_ownership.py
@@ -0,0 +1,54 @@
+from array import array
+from unittest.mock import Mock
+
+import pytest
+
+from sglang.srt.mem_cache.radix_cache import RadixKey
+from sglang.srt.mem_cache.unified_cache.unified_tree_core import (
+    UnifiedTreeCore,
+    UnifiedTreeNode,
+)
+
+
+def fixture():
+    core = UnifiedTreeCore.__new__(UnifiedTreeCore)
+    core.page_size = 64
+    core.component_types = ()
+    core.components = ()
+    core._node_arena = {}
+    core.tlru_bookkeeping = False
+    core._for_each_component_lru = Mock()
+    core._update_evictable_leaf_sets = Mock()
+    core._update_duplicate_tracking = Mock()
+    root = UnifiedTreeNode(())
+    child = UnifiedTreeNode(())
+    child.key = RadixKey(array("q", range(192)), None)
+    child.parent = root
+    root.children[child.key.child_key(core.page_size)] = child
+    return core, root, child
+
+
+@pytest.mark.parametrize("split_len", [64, 128])
+def test_split_registration_and_removal_use_the_same_key(split_len):
+    core, root, child = fixture()
+    prefix, action = core._split_node(child.key, child, split_len)
+    assert action is None
+    assert root.children.pop(prefix.key.child_key(core.page_size)) is prefix
+    assert not root.children
+    assert prefix.children[child.key.child_key(core.page_size)] is child
+    assert child.parent is prefix
+    assert core._node_arena[prefix.id] is prefix
+
+
+@pytest.mark.parametrize("split_len", [0, -64, 32, 192, 256])
+def test_invalid_split_rejected_before_mutation(split_len):
+    core, root, child = fixture()
+    original_key = child.key
+    original_children = dict(root.children)
+    with pytest.raises(AssertionError, match="invalid radix split"):
+        core._split_node(child.key, child, split_len)
+    assert child.parent is root
+    assert child.key is original_key
+    assert root.children == original_children
+    assert not core._node_arena
+    core._for_each_component_lru.assert_not_called()
