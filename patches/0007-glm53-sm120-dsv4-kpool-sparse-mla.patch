From: CoreNode homelab <noreply@corenode.com>
Subject: [PATCH] glm53: preserve KPool tails in SM120 sparse MLA

The architecture allowlist alone is insufficient for GLM-5.3 on SM120.  Its
2,048-wide DSA table has three live index_kpool tail slots, but the generic
FlashInfer adapter is for a different 656-byte GLM-NSA cache and the backend
guard rejects every other sparse-MLA implementation before warmup completes.

Route the model's 584-byte DSv4 footer cache through FlashInfer's supported
dual-segment ABI: 128 primary columns plus the remaining 1,923 columns, with
both segments reading the same physical cache.  Use full segment lengths so
-1 padding in the base table cannot mask the live KPool tail.  This preserves
all candidates without allocating a second KV cache.  Keep the original
656-byte adapter unchanged and open the KPool guard only for the corrected
584-byte path.

---
 python/sglang/kernels/ops/attention/flash_mla_sm120.py | 68 +++++++++++++++++++
 python/sglang/srt/layers/attention/dsa_backend.py      |  1 +
 2 files changed, 69 insertions(+)

diff --git a/python/sglang/kernels/ops/attention/flash_mla_sm120.py b/python/sglang/kernels/ops/attention/flash_mla_sm120.py
--- a/python/sglang/kernels/ops/attention/flash_mla_sm120.py
+++ b/python/sglang/kernels/ops/attention/flash_mla_sm120.py
@@ -622,6 +622,68 @@
     skip_softmax_threshold_scale_factor: float | None,
 ) -> torch.Tensor:
     """Run FlashInfer's SM120 sparse MLA kernel on SGLang's packed DSA cache."""
+
+    # GLM-5.3 uses the DSv4 footer cache (584 bytes/token, q head dim 512),
+    # not the 656-byte GLM-NSA cache handled by the generic MLA adapter below.
+    # Its fixed index_topk=2048 table also carries index_kpool-1=3 live tail
+    # slots. FlashInfer's SM120 DSv4 dual-cache kernels accept a fixed
+    # 128-column primary segment plus a runtime-width secondary segment. Point
+    # both segments at the same physical cache: this keeps every KPool tail
+    # token, uses the decode and prefill kernels' supported shapes, and avoids
+    # allocating a duplicate KV pool.
+    if kv_cache_dim == 584:
+        from flashinfer.mla import trtllm_batch_decode_sparse_mla_dsv4
+
+        if q.shape[-1] != 512:
+            raise ValueError(
+                "The 584-byte SM120 DSv4 cache requires q head dim 512, "
+                f"got {q.shape[-1]}."
+            )
+        if skip_softmax_threshold_scale_factor is not None:
+            raise ValueError(
+                "Skip-softmax is not supported by the SM120 DSv4 sparse-MLA "
+                "kernel."
+            )
+
+        packed_kv = kv_cache.view(torch.uint8).view(
+            -1, page_size, 1, kv_cache_dim
+        )
+        if page_size != _PBS_DST:
+            packed_kv = _split_kv_pages_to_64(
+                packed_kv,
+                page_size,
+                touched_indices=indices,
+            )
+
+        primary_width = min(128, indices.shape[-1])
+        primary_indices = indices[:, :primary_width].contiguous()
+        extra_indices = indices[:, primary_width:].contiguous()
+        # Rows shorter than index_topk are already padded with -1. Use the
+        # complete segment widths so a valid KPool tail after that padding is
+        # not masked by the base sequence length; the kernels skip -1 entries.
+        primary_lens = torch.full_like(indices[:, 0], primary_width)
+        extra_lens = (
+            torch.full_like(indices[:, 0], extra_indices.shape[-1])
+            if extra_indices.shape[-1] > 0
+            else None
+        )
+
+        result = trtllm_batch_decode_sparse_mla_dsv4(
+            query=q.unsqueeze(1),
+            swa_kv_cache=packed_kv,
+            workspace_buffer=workspace_buffer,
+            sparse_indices=primary_indices,
+            compressed_kv_cache=(packed_kv if extra_lens is not None else None),
+            swa_topk_lens=primary_lens,
+            extra_sparse_indices=(extra_indices if extra_lens is not None else None),
+            extra_sparse_topk_lens=extra_lens,
+            bmm1_scale=float(sm_scale),
+            bmm2_scale=1.0,
+            kv_layout="NHD",
+            backend="sparse",
+        )
+        return result.squeeze(1)
+
     from flashinfer.mla import trtllm_batch_decode_with_kv_cache_mla
 
     topk = indices.shape[1]
diff --git a/python/sglang/srt/layers/attention/dsa_backend.py b/python/sglang/srt/layers/attention/dsa_backend.py
--- a/python/sglang/srt/layers/attention/dsa_backend.py
+++ b/python/sglang/srt/layers/attention/dsa_backend.py
@@ -876,6 +876,7 @@
             topk_indices is None
             or self.dsa_index_kpool <= 1
             or dsa_impl in ("fa3", "tilelang", "trtllm")
+            or (dsa_impl == "flashinfer_sparse_mla" and self.kv_cache_dim == 584)
         ):
             return
         raise NotImplementedError(
