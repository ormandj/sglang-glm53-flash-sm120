+    } else if (mt == ModelType::GLM_NEXT_NOPE) {   \
+      DSV3_2_DISPATCH_MT(ModelType::GLM_NEXT_NOPE, H, K) \
     }                                              \
   } while (0);
   DSV3_2_DISPATCH(8, 128)
@@ -159,6 +162,7 @@ bool launch_sparse_mla_decode_dsv3_2(ModelType mt, int num_heads, int topk, int
   DSV3_2_DISPATCH(32, 512)
   DSV3_2_DISPATCH(32, 1024)
   DSV3_2_DISPATCH(32, 2048)
+  DSV3_2_DISPATCH(32, 2176)
   DSV3_2_DISPATCH(64, 128)
   DSV3_2_DISPATCH(64, 512)
   DSV3_2_DISPATCH(64, 1024)
