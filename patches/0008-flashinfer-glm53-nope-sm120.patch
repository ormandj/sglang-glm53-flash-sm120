From: CoreNode homelab <noreply@corenode.com>
Subject: [PATCH] sparse-mla-sm120: add GLM_NEXT no-RoPE 528-byte layout

GLM-5.3 uses a 512-dimensional latent query with no RoPE cache payload.
Its generic SGLang FP8 MLA pool stores 512 E4M3 bytes followed by four
arbitrary FP32 scales, for 528 bytes per token. Add that exact layout to the
SM120 V32-family decode and prefill kernels, together with the TP=2
32-head/2,176-candidate specialization required to preserve all 2,051 KPool
entries after padding to complete 64-entry tiles.

Keep the existing DSv3.2, GLM-NSA, and DSv4 layouts unchanged. Add numerical
decode and prefill coverage with a base-table padding gap followed by live
KPool tail entries.

---
diff --git a/csrc/sparse_mla_sm120.cu b/csrc/sparse_mla_sm120.cu
index 2d24432b4a949a0e27ee4c8e99001e4bf39c8ecb..8ae89659d3031cf3fc9cbd6363fb0ce972cb836c 100644
--- a/csrc/sparse_mla_sm120.cu
+++ b/csrc/sparse_mla_sm120.cu
@@ -68,8 +68,8 @@ inline ModelType resolve_model_type(int d_qk, int64_t model_type) {
   if (d_qk == 512) {
     const auto mt = static_cast<ModelType>(
         model_type == kAuto ? static_cast<int64_t>(ModelType::DSV4) : model_type);
-    TVM_FFI_ICHECK(mt == ModelType::DSV4)
-        << "d_qk=512 supports only model_type auto or DSV4; got " << model_type;
+    TVM_FFI_ICHECK(mt == ModelType::DSV4 || mt == ModelType::GLM_NEXT_NOPE)
+        << "d_qk=512 supports model_type auto, DSV4, or GLM_NEXT_NOPE; got " << model_type;
     return mt;
   }
   TVM_FFI_ICHECK(false) << "Unsupported d_qk=" << d_qk
@@ -82,6 +82,8 @@ inline int bytes_per_token(ModelType mt) {
     case ModelType::DSV3_2:
     case ModelType::GLM_NSA:
       return 656;
+    case ModelType::GLM_NEXT_NOPE:
+      return 528;
     case ModelType::DSV4:
       return 584;
   }
@@ -270,8 +272,11 @@ void SparseMlaSm120PagedAttention(
       stream);
   TVM_FFI_ICHECK(ok) << "Unsupported sparse-MLA prefill configuration: "
                      << "model="
-                     << (mt == ModelType::DSV3_2 ? "DSV3_2"
-                                                 : (mt == ModelType::GLM_NSA ? "GLM_NSA" : "DSV4"))
+                     << (mt == ModelType::DSV3_2
+                             ? "DSV3_2"
+                             : (mt == ModelType::GLM_NSA
+                                    ? "GLM_NSA"
+                                    : (mt == ModelType::GLM_NEXT_NOPE ? "GLM_NEXT_NOPE" : "DSV4")))
                      << " num_heads=" << num_heads << " topk=" << topk
                      << " page_block_size=" << page_block_size << " topk_extra=" << extra_topk
                      << " extra_page_block_size=" << extra_page_block_size;
