+    if (tx == 0) s_counter = 0;
+    __syncthreads();
+    for (int idx = tx; idx < length; idx += BLOCK_SIZE) {
+      if (make_topk_key(input[idx + row_start], idx) >= threshold_key) {
+        const auto pos = ::atomicAdd(&s_counter, 1);
+        index[pos] = idx;
+      }
+    }
+    __syncthreads();
+    return;
   } else {
     __syncthreads();
     if (tx < RADIX + 1) {
@@ -157,9 +267,11 @@ fast_topk_cuda_tl_impl(const float* __restrict__ input, int* __restrict__ index,
